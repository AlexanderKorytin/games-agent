<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@ИМЯ@</string>
  <!-- Связь с «Игровой агент.app»: в «Фоновой активности» macOS службы видны одним пунктом
       с именем и значком приложения, а не как четыре «uv» (живой сценарий пользователя). -->
  <key>AssociatedBundleIdentifiers</key><array><string>local.games-agent</string></array>
  <key>ProgramArguments</key>
  <array>
    <!-- Первым идёт запускающий файл внутри «Игровой агент.app», а не `uv`: macOS называет
         фоновый объект по первому файлу, и иначе в настройках было бы четыре «uv». -->
    <string>@ЗАПУСК@</string><string>@ПРОГРАММА@</string>
@ДОВОДЫ@  </array>
  <key>WorkingDirectory</key><string>@КОД@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@ПУТЬ@</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>@ЖУРНАЛЫ@/@КОРОТКО@.log</string>
  <key>StandardErrorPath</key><string>@ЖУРНАЛЫ@/@КОРОТКО@.log</string>
@РАСПИСАНИЕ@</dict>
</plist>
